import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import { randomUUID } from 'node:crypto';

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
const panel = '[aria-label="\u8282\u70b9\u7f16\u8f91\u9762\u677f"]';
const picker = '[aria-label="\u9009\u62e9\u753b\u5e03\u8282\u70b9"]';
const documents = '[aria-label="\u9009\u62e9\u753b\u5e03"]';
const edit = '[aria-label="\u7f16\u8f91\u6240\u9009\u8282\u70b9"]';
const move = '[aria-label="\u79fb\u52a8\u6240\u9009\u8282\u70b9"]';
const done = '[aria-label="\u5b8c\u6210\u79fb\u52a8"]';
const locate = '[aria-label="\u5b9a\u4f4d\u6240\u9009\u8282\u70b9"]';
const seed = '[aria-label="\u8282\u70b9\u968f\u673a\u79cd\u5b50\uff08\u53ef\u9009\uff09"]';
const promptSource = '[aria-label="\u9009\u62e9\u63d0\u793a\u8bcd"]';
const connectPrompt = '[aria-label="\u8fde\u63a5\u9009\u62e9\u63d0\u793a\u8bcd"]';
const replacePrompt = '[aria-label="\u66ff\u6362\u63d0\u793a\u8bcd\u6765\u6e90"]';
const confirmPrompt = '[aria-label="\u786e\u8ba4\u66ff\u6362\u63d0\u793a\u8bcd\u6765\u6e90"]';
const remove = '[aria-label="\u79fb\u9664\u6240\u9009\u8282\u70b9"]';
const removeConfirm = '\u786e\u8ba4\u79fb\u9664\u8282\u70b9';
const closePrompt = '[aria-label="\u5173\u95ed\u8282\u70b9\u7f16\u8f91"]';

export async function mobilePhoneChecks(context) {
  const { browser, second, api, output, L, sends, uploads, saves, currentScene, domGeometry, canvasMode, selectTitle, rename, setStage, pass, until, fixturePng, emptyScene, defaults } = context;
  const counts = () => ({ runs: sends().length, saves: saves().length });
  const assertCounts = (expected) => assert.deepEqual(counts(), expected, 'Only explicit actions submit or account-save');
  const device = async (width, height) => {
    await browser.send('Emulation.setDeviceMetricsOverride', { width, height, deviceScaleFactor: 1, mobile: true });
    await browser.send('Emulation.setTouchEmulationEnabled', { enabled: true, maxTouchPoints: 2 });
    await sleep(400);
  };
  const scrollControl = async (selector) => {
    await browser.evaluate(`document.querySelector(${JSON.stringify(selector)})?.scrollIntoView({block:'nearest',inline:'nearest'})`);
    await sleep(80);
    const point = await browser.point(selector);
    const size = await browser.evaluate('({width:innerWidth,height:innerHeight})');
    assert.ok(point.x >= 0 && point.x < size.width && point.y >= 0 && point.y < size.height, 'Reachable control: ' + selector);
  };
  const click = async (selector) => { await scrollControl(selector); await browser.click(selector); };
  const select = async (selector, value) => { await scrollControl(selector); await browser.select(selector, value); };
  const selectNode = async (id) => { await select(picker, id); await sleep(100); };
  const openNode = async (id) => { await selectNode(id); await click(edit); await browser.wait(`Boolean(document.querySelector(${JSON.stringify(panel)}))`); };
  const closePanel = async () => {
    const selector = await browser.evaluate(`document.querySelector(${JSON.stringify(panel)})?.querySelector('[aria-label="\u5173\u95ed\u8282\u70b9\u8bbe\u7f6e"]') ? '[aria-label="\u5173\u95ed\u8282\u70b9\u8bbe\u7f6e"]' : ${JSON.stringify(closePrompt)}`);
    if (await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(panel)}))`)) await click(selector);
  };
  const touch = (type, points) => browser.send('Input.dispatchTouchEvent', { type, touchPoints: points.map((point, index) => ({ radiusX: 2, radiusY: 2, force: 1, id: index + 1, ...point })) });
  const touchTap = async (selector) => { const point = await browser.controlPoint(selector); await touch('touchStart', [{ x: point.x, y: point.y }]); await touch('touchEnd', []); await sleep(200); };
  const canvasBox = () => browser.evaluate(`(()=>{const r=document.querySelector('[data-testid=canvas-viewport]').getBoundingClientRect();return {x:r.x,y:r.y,width:r.width,height:r.height}})()`);
  const inputGeometry = () => browser.evaluate(`(()=>{const p=document.querySelector(${JSON.stringify(panel)}),t=document.querySelector(${JSON.stringify(L.promptInput)});const r=p.getBoundingClientRect();const touchActions=[];for(let e=t;e;e=e.parentElement)touchActions.push({tag:e.tagName,class:e.className,touchAction:getComputedStyle(e).touchAction});return {panel:{x:r.x,y:r.y,width:r.width,height:r.height,transform:getComputedStyle(p).transform},font:Number.parseFloat(getComputedStyle(t).fontSize),touchActions,documentWidth:document.documentElement.scrollWidth,width:innerWidth,height:innerHeight,same:t===window.__mobilePrompt,focused:document.activeElement===t,buttons:[...p.querySelectorAll('button')].map(b=>({label:b.getAttribute('aria-label')??b.textContent.trim(),width:b.getBoundingClientRect().width,height:b.getBoundingClientRect().height}))}})()`);

  setStage('Phone editing capability, explicit unscaled prompt editor, native CDP composition and responsive focus');
  const beforePhone = counts();
  await closePanel();
  await device(390, 844);
  await browser.byText(L.new);
  await browser.wait('Boolean(document.querySelector(".react-flow")) && document.querySelectorAll(".react-flow__node").length===0');
  const phoneCanvasId = await browser.activeId();
  await rename(browser, 'Phone C');
  await browser.byText(L.prompt, '[aria-label="\u753b\u5e03\u5de5\u5177\u680f"]');
  await browser.wait('document.querySelectorAll(".react-flow__node-prompt").length===1');
  const phonePromptId = (await currentScene(browser)).nodes.find((node) => node.kind === 'prompt').id;
  assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(panel)}))`), false, 'Selection is not edit-open intent');
  assert.equal(await browser.evaluate('document.querySelectorAll(".react-flow__node textarea,.react-flow__handle.connectable").length'), 0);
  await click(edit);
  await browser.wait(`Boolean(document.querySelector(${JSON.stringify(L.promptInput)}))`);
  await browser.click(L.promptInput);
  await browser.evaluate(`(()=>{const t=document.querySelector(${JSON.stringify(L.promptInput)});window.__mobilePrompt=t;window.__mobileWrites=[];window.__mobileComposition=[];const descriptor=Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value');Object.defineProperty(HTMLTextAreaElement.prototype,'value',{...descriptor,set(value){if(this===window.__mobilePrompt)window.__mobileWrites.push(value);descriptor.set.call(this,value)}});for(const name of ['compositionstart','compositionend','input'])t.addEventListener(name,e=>window.__mobileComposition.push({name,data:e.data,value:t.value,composing:e.isComposing}))})()`);
  const chinese = '\u624b\u673a\u753b\u5e03\u4e2d\u6587\u8f93\u5165';
  await browser.send('Input.imeSetComposition', { text: chinese, selectionStart: chinese.length, selectionEnd: chinese.length });
  await browser.key('Enter', 'Enter', 229);
  assertCounts(beforePhone);
  await browser.send('Input.insertText', { text: chinese });
  await sleep(200);
  assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(L.promptInput)}).value`), chinese);
  assert.equal((await browser.evaluate('window.__mobileWrites')).includes(''), false, 'No prior native value restored during composition');
  assert.ok((await browser.evaluate('window.__mobileComposition')).some((item) => item.name === 'compositionend'));
  await browser.key('Enter', 'Enter', 13);
  assertCounts(beforePhone);
  const longText = Array.from({ length: 30 }, (_, index) => chinese + ' ' + index).join('\n');
  await browser.replaceText(L.promptInput, longText);
  const cameraBeforeWheel = (await domGeometry(browser)).viewport;
  const fieldPoint = await browser.point(L.promptInput);
  await browser.mouse('mouseWheel', fieldPoint.x, fieldPoint.y, { deltaX: 0, deltaY: 240 });
  await sleep(200);
  assert.ok(await browser.evaluate(`document.querySelector(${JSON.stringify(L.promptInput)}).scrollTop>0`));
  assert.equal((await domGeometry(browser)).viewport, cameraBeforeWheel);
  await browser.replaceText(L.promptInput, 'Phone frozen prompt');
  const acceptedNodes = (await currentScene(browser)).nodes;
  const layouts = [];
  for (const [width, height] of [[360, 844], [390, 844], [430, 932], [844, 390], [390, 440]]) {
    await device(width, height);
    const measures = await inputGeometry();
    assert.ok(measures.same && measures.focused, 'Responsive layout retains the exact focused field DOM');
    assert.ok(measures.font >= 16 && measures.panel.transform === 'none');
    for (const ancestor of measures.touchActions) {
      assert.ok(ancestor.touchAction === 'auto' || ancestor.touchAction === 'manipulation' || ancestor.touchAction.includes('pinch-zoom'), 'Untransformed prompt/editor ancestors retain accessibility pinch: ' + JSON.stringify(ancestor));
    }
    assert.ok(measures.documentWidth <= width && measures.panel.x >= -0.5 && measures.panel.y >= -0.5 && measures.panel.y + measures.panel.height <= height + 1);
    for (const control of measures.buttons) assert.ok(control.width >= 43.5 && control.height >= 43.5, 'Touch-sized panel action: ' + control.label);
    assert.deepEqual((await currentScene(browser)).nodes, acceptedNodes);
    assertCounts(beforePhone);
    layouts.push({ viewport: { width, height }, measures });
    await browser.shot('phone-editor-' + width + 'x' + height);
  }
  await device(390, 844);
  await closePanel();
  pass({ phoneCanvasId, phonePromptId, layouts, composition: 'Native Chrome CDP events/setter instrumentation, not native OS candidate UI', noImplicitRunOrSave: true });

  setStage('Phone untransformed editor permits browser accessibility pinch without changing scene camera or submitting');
  await openNode(phonePromptId);
  await browser.evaluate(`void(window.__mobileZoomPrompt=document.querySelector(${JSON.stringify(L.promptInput)}))`);
  const zoomPoint = await browser.controlPoint(L.promptInput);
  const beforeAccessibility = counts(), beforeAccessibilityScene = await currentScene(browser);
  const beforeAccessibilityCamera = (await domGeometry(browser)).viewport;
  const beforePageScale = await browser.evaluate('visualViewport.scale');
  await browser.send('Input.synthesizePinchGesture', { x: zoomPoint.x, y: zoomPoint.y, scaleFactor: 1.25, relativeSpeed: 800, gestureSourceType: 'touch' });
  await sleep(450);
  const afterPageScale = await browser.evaluate('visualViewport.scale');
  assert.ok(afterPageScale > beforePageScale + 0.02, 'Browser page zoom remains enabled inside the editor');
  assert.equal((await domGeometry(browser)).viewport, beforeAccessibilityCamera);
  assert.deepEqual((await currentScene(browser)).nodes, beforeAccessibilityScene.nodes);
  assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(L.promptInput)})===window.__mobileZoomPrompt`), true);
  assertCounts(beforeAccessibility);
  await browser.shot('phone-accessibility-pinch');
  await browser.send('Emulation.setPageScaleFactor', { pageScaleFactor: 1 });
  await sleep(300); await closePanel();
  pass({ beforePageScale, afterPageScale, cameraUnchanged: true, stableFieldDOM: true, noRunOrSave: true, method: 'Desktop Chromium CDP synthesized touch pinch, not physical Safari/Android accessibility acceptance' });

  setStage('Actual phone touch browse, captured whole-card Move, cancelled/second-finger previews and native draft commits');
  await selectNode(phonePromptId);
  await click(move);
  await browser.wait('document.querySelector("[data-testid=canvas-viewport]").dataset.interactionMode==="move"');
  await sleep(300);
  const nodeSelector = `.react-flow__node[data-id="${phonePromptId}"] article`;
  const nodePosition = async () => (await currentScene(browser)).nodes.find((node) => node.id === phonePromptId).position;
  const startPosition = await nodePosition();
  const point = await browser.point(nodeSelector, 0.4, 0.6);
  const worldBefore = await domGeometry(browser);
  await touch('touchStart', [{ x: point.x, y: point.y }]);
  for (let index = 1; index <= 8; index += 1) { await touch('touchMove', [{ x: point.x + 24 * index / 8, y: point.y + 16 * index / 8 }]); await sleep(25); }
  await sleep(750);
  assert.deepEqual(await nodePosition(), startPosition, 'An unfinished preview never becomes an autosaved domain position');
  assert.notDeepEqual((await domGeometry(browser)).nodes, worldBefore.nodes, 'Renderer displays the unfinished preview');
  await touch('touchEnd', []);
  const dropped = await nodePosition();
  assert.notDeepEqual(dropped, startPosition);
  const cancelPoint = await browser.point(nodeSelector, 0.4, 0.6);
  await touch('touchStart', [{ x: cancelPoint.x, y: cancelPoint.y }]);
  await touch('touchMove', [{ x: cancelPoint.x + 22, y: cancelPoint.y + 8 }]);
  await touch('touchCancel', []);
  assert.deepEqual(await nodePosition(), dropped, 'Pointer cancellation retains the last accepted drop');
  const secondPoint = await browser.point(nodeSelector, 0.4, 0.6);
  await touch('touchStart', [{ x: secondPoint.x, y: secondPoint.y }]);
  await touch('touchMove', [{ x: secondPoint.x + 18, y: secondPoint.y }]);
  await touch('touchStart', [{ x: secondPoint.x + 18, y: secondPoint.y }, { x: secondPoint.x + 66, y: secondPoint.y + 15 }]);
  await touch('touchMove', [{ x: secondPoint.x + 10, y: secondPoint.y }, { x: secondPoint.x + 74, y: secondPoint.y + 15 }]);
  await touch('touchEnd', []);
  assert.deepEqual(await nodePosition(), dropped, 'A second finger cannot commit the pending node preview');
  await click(done);
  const box = await canvasBox();
  const cameraBeforePan = (await domGeometry(browser)).viewport;
  await touch('touchStart', [{ x: box.x + 14, y: box.y + box.height * 0.8 }]);
  for (let i = 1; i <= 8; i += 1) { await touch('touchMove', [{ x: box.x + 14 + i * 4, y: box.y + box.height * 0.8 - i * 3 }]); await sleep(25); }
  await touch('touchEnd', []); await sleep(300);
  const panned = (await domGeometry(browser)).viewport;
  assert.notEqual(panned, cameraBeforePan);
  await touch('touchStart', [{ x: box.x + 45, y: box.y + box.height * 0.75 }, { x: box.x + box.width - 45, y: box.y + box.height * 0.75 }]);
  for (let i = 1; i <= 6; i += 1) { await touch('touchMove', [{ x: box.x + 45 - i * 3, y: box.y + box.height * 0.75 }, { x: box.x + box.width - 45 + i * 3, y: box.y + box.height * 0.75 }]); await sleep(25); }
  await touch('touchEnd', []); await sleep(300);
  const pinched = (await domGeometry(browser)).viewport;
  assert.notEqual(pinched, panned);
  assert.deepEqual(await nodePosition(), dropped);
  await selectNode(phonePromptId); await click(locate); await sleep(250); await touchTap(nodeSelector);
  assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(panel)}))`), false);
  assertCounts(beforePhone);
  pass({ device: 'Desktop Chromium CDP touch emulation, not a physical phone', startPosition, dropped, rendererOnlyPreview: true, cancelledDropPreserved: true, secondFingerPreserved: true, cameraBeforePan, panned, pinched });

  setStage('Mounted unfinished phone parameter drafts block Run/Save and survive panel/node/mode changes');
  await browser.byText(L.gen, '[aria-label="\u753b\u5e03\u5de5\u5177\u680f"]');
  const phoneGenerationId = (await currentScene(browser)).nodes.find((node) => node.kind === 'generation').id;
  await click(edit);
  await scrollControl(seed);
  await browser.replaceText(seed, 'unfinished-seed');
  await browser.byText(L.run, panel);
  assertCounts(beforePhone);
  assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(seed)}).value`), 'unfinished-seed');
  await browser.byText(L.save);
  assertCounts(beforePhone);
  assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(seed)}).getAttribute('aria-invalid')`), 'true');
  await closePanel();
  await browser.byText(L.chat, L.mode); await browser.wait('Boolean(document.querySelector("textarea[placeholder]"))');
  await canvasMode(browser);
  await openNode(phoneGenerationId);
  await scrollControl(seed);
  assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(seed)}).value`), 'unfinished-seed');
  await browser.replaceText(seed, '123'); await browser.key('Enter', 'Enter', 13);
  assert.equal((await currentScene(browser)).nodes.find((node) => node.id === phoneGenerationId).parameters.seed, 123);
  await browser.replaceText(seed, ''); await browser.key('Enter', 'Enter', 13);
  assertCounts(beforePhone);
  await select(promptSource, phonePromptId); await click(connectPrompt);
  await closePanel();
  pass({ phoneGenerationId, invalidDraftPreserved: true, blockedRunAndSave: true, nativeEnterAppliesParameterOnly: true, rootDraftSurvivesLazyModeUnmount: true });

  setStage('Phone node runtime settings remain unscaled/reachable across short layouts without persisting credentials or submitting');
  await openNode(phoneGenerationId);
  await click(`${panel} [aria-label="\u8282\u70b9\u6e20\u9053\u6765\u6e90"] button:nth-child(2)`);
  await browser.byText('\u914d\u7f6e\u6b64\u8282\u70b9\u7684 API \u51ed\u636e', panel);
  await browser.wait('Boolean(document.querySelector("[aria-label=\"\u753b\u5e03 Base URL\"]"))');
  const runtimeURL = '[aria-label="\u753b\u5e03 Base URL"]';
  await scrollControl(runtimeURL); await browser.replaceText(runtimeURL, 'https://phone-fixture.invalid/v1');
  await scrollControl('[aria-label="\u753b\u5e03 API Key"]'); await browser.replaceText('[aria-label="\u753b\u5e03 API Key"]', 'fixture-only-key');
  await scrollControl('[aria-label="\u753b\u5e03\u6e20\u9053\u540d\u79f0"]'); await browser.replaceText('[aria-label="\u753b\u5e03\u6e20\u9053\u540d\u79f0"]', 'Phone fixture');
  await scrollControl(runtimeURL); await browser.click(runtimeURL);
  await browser.evaluate(`void(window.__mobileRuntimeURL=document.querySelector(${JSON.stringify(runtimeURL)}))`);
  const runtimeLayouts = [], beforeSettings = counts();
  for (const [width, height] of [[360, 844], [844, 390], [390, 440]]) {
    await device(width, height);
    const measures = await browser.evaluate(`(()=>{const e=document.querySelector(${JSON.stringify(runtimeURL)}),d=document.querySelector('[role=dialog]'),r=d.getBoundingClientRect();return {same:e===window.__mobileRuntimeURL,focused:document.activeElement===e,font:Number.parseFloat(getComputedStyle(e).fontSize),dialog:{x:r.x,y:r.y,width:r.width,height:r.height},width:innerWidth,height:innerHeight}})()`);
    assert.ok(measures.same && measures.focused && measures.font >= 16);
    assert.ok(measures.dialog.x >= 0 && measures.dialog.y >= 0 && measures.dialog.y + measures.dialog.height <= height + 1);
    assertCounts(beforeSettings); runtimeLayouts.push({ width, height, measures });
    await browser.shot('phone-runtime-' + width + 'x' + height);
  }
  await browser.evaluate(`(()=>{const b=[...document.querySelector('[role=dialog]').querySelectorAll('button')].find(e=>e.textContent.trim()==='\u4ec5\u5728\u672c\u9875\u4f7f\u7528');b.setAttribute('data-mobile-runtime-confirm','true')})()`);
  await click('[data-mobile-runtime-confirm=true]'); await browser.wait('!document.querySelector("[role=dialog]")');
  assertCounts(beforeSettings);
  assert.equal(JSON.stringify(await browser.nativeDrafts()).includes('fixture-only-key'), false);
  await device(390, 844);
  await click(`${panel} [aria-label="\u8282\u70b9\u6e20\u9053\u6765\u6e90"] button:first-child`);
  await closePanel();
  pass({ runtimeLayouts, dummyCredentialsOnly: true, credentialsExcludedFromNativeDrafts: true, settingsAreNotRun: true, captchaVendorAndNativeKeyboardUnverified: true });

  setStage('Phone local original import, panel connections, atomic replacement/disconnection and explicit order');
  const files = [path.join(output, 'phone-a.png'), path.join(output, 'phone-b.png'), path.join(output, 'phone-c.png')];
  await fs.writeFile(files[0], fixturePng()); await fs.writeFile(files[1], fixturePng(true)); await fs.writeFile(files[2], fixturePng());
  const uploadBefore = uploads().length;
  const dom = await browser.send('DOM.getDocument');
  const fileInput = await browser.send('DOM.querySelector', { nodeId: dom.root.nodeId, selector: L.import });
  await browser.send('DOM.setFileInputFiles', { nodeId: fileInput.nodeId, files });
  await browser.wait('document.querySelectorAll(".react-flow__node-reference").length===3');
  assert.equal(uploads().length, uploadBefore);
  const referenceIds = (await currentScene(browser)).nodes.filter((node) => node.kind === 'reference').map((node) => node.id);
  await openNode(phoneGenerationId);
  for (const id of referenceIds.slice(0, 2)) { await select(L.refPicker, id); await click(L.connectRef); }
  await click('[aria-label="\u4e0a\u79fb\u53c2\u8003\u56fe 2"]');
  const orderedBefore = (await currentScene(browser)).edges.filter((edge) => edge.target === phoneGenerationId && edge.kind === 'image-input').sort((a, b) => a.ordinal - b.ordinal);
  assert.deepEqual(orderedBefore.map((edge) => edge.source), referenceIds.slice(0, 2).reverse());
  const replaceInput = '[aria-label="\u66ff\u6362\u53c2\u8003\u56fe 1 \u6765\u6e90"]';
  const confirmInput = '[aria-label="\u786e\u8ba4\u66ff\u6362\u53c2\u8003\u56fe 1 \u6765\u6e90"]';
  await select(replaceInput, referenceIds[0]); await click(confirmInput);
  assert.deepEqual((await currentScene(browser)).edges.filter((edge) => edge.target === phoneGenerationId && edge.kind === 'image-input').sort((a, b) => a.ordinal - b.ordinal), orderedBefore, 'Duplicate replacement leaves old edge/order intact');
  await select(replaceInput, referenceIds[2]); await click(confirmInput);
  const replaced = (await currentScene(browser)).edges.filter((edge) => edge.target === phoneGenerationId && edge.kind === 'image-input').sort((a, b) => a.ordinal - b.ordinal);
  assert.equal(replaced[0].id, orderedBefore[0].id); assert.equal(replaced[0].ordinal, orderedBefore[0].ordinal); assert.equal(replaced[0].source, referenceIds[2]);
  await click('[aria-label="\u65ad\u5f00\u53c2\u8003\u56fe 2"]');
  await select(L.refPicker, referenceIds[0]); await click(L.connectRef);
  await closePanel();
  await browser.byText(L.prompt, '[aria-label="\u753b\u5e03\u5de5\u5177\u680f"]');
  const alternatePromptId = (await currentScene(browser)).nodes.filter((node) => node.kind === 'prompt').find((node) => node.id !== phonePromptId).id;
  await click(edit); await browser.replaceText(L.promptInput, 'Alternate phone prompt'); await closePanel();
  await openNode(phoneGenerationId);
  const oldPromptEdge = (await currentScene(browser)).edges.find((edge) => edge.kind === 'prompt-input' && edge.target === phoneGenerationId);
  await select(replacePrompt, alternatePromptId); await click(confirmPrompt);
  let promptEdge = (await currentScene(browser)).edges.find((edge) => edge.id === oldPromptEdge.id);
  assert.equal(promptEdge.source, alternatePromptId);
  await select(replacePrompt, phonePromptId); await click(confirmPrompt);
  promptEdge = (await currentScene(browser)).edges.find((edge) => edge.id === oldPromptEdge.id);
  assert.equal(promptEdge.source, phonePromptId);
  assertCounts(beforePhone);
  pass({ referenceIds, localImportBeforeUpload: true, duplicateReplacementPreservesEdgeAndOrder: true, validReplacementPreservesEdgeIdAndOrdinal: true, promptEdgeIdentity: oldPromptEdge.id, disconnectedThenExplicitlyReconnected: true, originalFilePicker: 'Native CDP FileList, not OS chooser validation' });

  setStage('Phone captured account Save includes unused originals and never acknowledges newer local edits');
  api.controls.nextSave = 'delay';
  await browser.byText(L.save);
  await until(() => api.pendingGates.some((gate) => gate.kind === 'save' && gate.id === phoneCanvasId), 'Phone delayed captured Save');
  const saveGate = api.pendingGates.filter((gate) => gate.kind === 'save' && gate.id === phoneCanvasId).at(-1);
  const capturedPhone = structuredClone(api.account().documents.get(phoneCanvasId).scene);
  assert.equal(capturedPhone.nodes.filter((node) => node.kind === 'reference').length, 3);
  assert.ok(capturedPhone.nodes.filter((node) => node.kind === 'reference').every((node) => node.source.kind === 'imported'));
  assert.equal(uploads().length, uploadBefore + 3);
  await closePanel(); await openNode(phonePromptId);
  await browser.replaceText(L.promptInput, 'Phone newer local while Save'); await closePanel();
  saveGate.resolve();
  await browser.wait('document.body.textContent.includes("\u6709\u672a\u540c\u6b65\u4fee\u6539")');
  assert.equal(api.account().documents.get(phoneCanvasId).scene.nodes.find((node) => node.id === phonePromptId).text, 'Phone frozen prompt');
  assert.equal((await currentScene(browser)).nodes.find((node) => node.id === phonePromptId).text, 'Phone newer local while Save');
  assert.equal(sends().length, beforePhone.runs);
  const native = (await browser.nativeDrafts()).find((row) => row.canvasId === phoneCanvasId);
  assert.equal(native.fixtureBlobs.length, 3);
  pass({ savedSameCanvasId: phoneCanvasId, allOriginalsCaptured: 3, uploadedOriginals: uploads().length - uploadBefore, newerEditRemainsDirty: true, nativeOriginalBlobs: native.fixtureBlobs });

  setStage('Phone explicit ready single-node Run, double-tap admission, frozen inputs and result origin across mode/node switches');
  const beforeRun = counts();
  await openNode(phoneGenerationId);
  api.controls.nextGenerate = 'delay';
  await browser.byText(L.run, panel);
  await until(() => sends().length === beforeRun.runs + 1, 'Phone explicit Run admitted');
  await browser.click(`${panel} footer button`);
  assert.equal(sends().length, beforeRun.runs + 1, 'Second tap does not admit a second run');
  const phoneWire = sends().at(-1).body.canvasRun;
  const originalAssets = Object.fromEntries(capturedPhone.nodes.filter((node) => node.kind === 'reference').map((node) => [node.id, node.source.assetId]));
  assert.equal(phoneWire.canvasId, phoneCanvasId); assert.equal(phoneWire.nodeId, phoneGenerationId);
  assert.equal(phoneWire.input.prompt.text, 'Phone newer local while Save');
  assert.deepEqual(phoneWire.input.references.map((input) => input.assetId), [originalAssets[referenceIds[2]], originalAssets[referenceIds[0]]]);
  assert.equal(phoneWire.parameters.count, 1);
  await closePanel(); await selectNode(alternatePromptId);
  await browser.byText(L.chat, L.mode);
  const runGate = api.pendingGates.find((gate) => gate.kind === 'generate' && gate.id === phoneWire.runId); assert.ok(runGate); runGate.resolve();
  await sleep(450); await canvasMode(browser);
  await browser.wait('document.querySelectorAll(".react-flow__node-result").length===1');
  assert.equal(await browser.evaluate(`document.querySelector(${JSON.stringify(picker)}).value`), alternatePromptId);
  assert.equal(sends().length, beforeRun.runs + 1); assert.equal(saves().length, beforeRun.saves);
  const afterRun = await currentScene(browser);
  const phoneResult = afterRun.nodes.find((node) => node.kind === 'result');
  assert.equal(afterRun.runBindings[0].nodeId, phoneGenerationId); assert.ok(afterRun.runBindings[0].outputsHandled);
  pass({ frozenWire: phoneWire, explicitSubmissions: 1, modeAndSelectionPreserved: true, resultId: phoneResult.id, noAutomaticSave: true });

  setStage('Native original download lease survives phone viewer/editor closure and organization-only reference removal');
  const retainedJobs = api.account().jobs.size;
  await openNode(referenceIds[1]);
  await click(`${panel} [aria-label="\u67e5\u770b\u53c2\u8003\u539f\u56fe"]`);
  await browser.wait('Boolean(document.querySelector("img[alt=\"\u653e\u5927\u67e5\u770b\"]"))');
  assert.equal(await browser.evaluate('document.body.textContent.includes("\u52a0\u5165\u7f16\u8f91")'), false);
  const completedBefore = browser.evidence.downloads.filter((item) => item.state === 'completed').length;
  await browser.evaluate(`(()=>{const original=window.fetch;window.__mobileHeldBlob=null;window.fetch=function(...args){const url=typeof args[0]==='string'?args[0]:args[0]?.url;if(url?.startsWith('blob:')&&!window.__mobileHeldBlob){window.__mobileHeldBlob=url;return new Promise(resolve=>{window.__mobileReleaseBlob=()=>{window.fetch=original;resolve(original.apply(window,args))}})}return original.apply(this,args)}})()`);
  await browser.byText('\u4fdd\u5b58\u9ad8\u6e05\u539f\u56fe');
  await browser.wait('Boolean(window.__mobileReleaseBlob)');
  await browser.click('[aria-label="\u5173\u95ed"]');
  await closePanel(); await click(remove); await browser.byText(removeConfirm);
  await browser.wait('!document.querySelector("[role=dialog]")');
  assert.equal((await currentScene(browser)).nodes.some((node) => node.id === referenceIds[1]), false);
  assert.equal(api.account().jobs.size, retainedJobs);
  await browser.evaluate('window.__mobileReleaseBlob()');
  await until(() => browser.evidence.downloads.filter((item) => item.state === 'completed').length === completedBefore + 1, 'Held native original download finishes after card/editor removal');
  const download = browser.evidence.downloads.filter((item) => item.state === 'completed').at(-1);
  assert.equal(path.dirname(download.filePath), path.join(output, 'desktop-downloads'));
  assert.deepEqual(await fs.readFile(download.filePath), await fs.readFile(files[1]));
  pass({ nativeBlobLease: true, fixtureFetchHold: 'Download fetch is delayed until viewer/editor/card close, then actual native blob bytes are fetched', originalDownloadBytesMatch: true, filePath: download.filePath, retainedCanonicalFakeJobs: retainedJobs, noCancellationOrRefundRequest: true });

  setStage('Separate desktop profile restores the captured phone account snapshot and READY originals without upload');
  const uploadsBeforeRestore = uploads().length;
  await second.send('Page.reload', { ignoreCache: true }); await second.wait('Boolean(window.__CANVAS_FIXTURE?.ready)'); await canvasMode(second); await selectTitle(second, 'Phone C');
  await second.wait('document.querySelectorAll(".react-flow__node-reference").length===3');
  const restored = await currentScene(second);
  assert.equal(await second.activeId(), phoneCanvasId);
  assert.equal(restored.nodes.find((node) => node.id === phonePromptId).text, 'Phone frozen prompt');
  assert.equal((await second.nativeDrafts()).find((row) => row.canvasId === phoneCanvasId).fixtureBlobs.length, 0);
  assert.equal(uploads().length, uploadsBeforeRestore);
  assert.equal(restored.nodes.filter((node) => node.kind === 'result').length, 0, 'Unsaved local results are not copied to another profile');
  pass({ snapshotCanvasId: phoneCanvasId, separateNativeProfile: true, capturedOldPromptNotNewerDraft: true, readyAssetsWithoutUpload: true, fixtureIdentityAndHTTP: true });

  setStage('Phone unavailable canonical result replacement rejects atomically without a request');
  const unavailable = emptyScene();
  const missingPrompt = randomUUID(), missingGeneration = randomUUID(), retainedReference = randomUUID(), missingImage = 'fixture-missing-image';
  unavailable.nodes.push({ id: missingPrompt, kind: 'prompt', position: { x: 0, y: 0 }, text: 'Ready prompt for missing-result probe' },
    { id: retainedReference, kind: 'reference', position: { x: 0, y: 380 }, source: { kind: 'imported', assetId: originalAssets[referenceIds[0]] } },
    { id: missingGeneration, kind: 'generation', position: { x: 380, y: 0 }, parameters: defaults },
    { id: 'result:' + missingImage, kind: 'result', position: { x: 380, y: 380 }, jobId: 'fixture-missing-job', imageId: missingImage });
  unavailable.edges.push({ id: randomUUID(), kind: 'prompt-input', source: missingPrompt, target: missingGeneration },
    { id: randomUUID(), kind: 'image-input', source: retainedReference, target: missingGeneration, ordinal: 1 });
  const missingCanvasId = api.seed('fixture-owner-a', 'Missing replacement probe', unavailable);
  await browser.send('Page.reload', { ignoreCache: true }); await browser.wait('Boolean(window.__CANVAS_FIXTURE?.ready)'); await canvasMode(browser);
  await select(documents, missingCanvasId); await browser.wait('document.querySelectorAll(".react-flow__node").length===4');
  await openNode(missingGeneration);
  const missingBefore = await currentScene(browser), missingCounts = counts();
  await select(replaceInput, 'result:' + missingImage); await click(confirmInput);
  assert.deepEqual((await currentScene(browser)).edges, missingBefore.edges);
  assertCounts(missingCounts);
  await closePanel();
  pass({ missingCanvasId, missingCanonicalResultRejected: true, originalEdgeAndOrdinalUnchanged: true, noGenerationOrSave: true });

  setStage('Phone 24-node/32-edge and 200-node actual-component smoke with current-scene chooser/Locate');
  const stress = [], stressCounts = counts();
  for (const count of [24, 200]) {
    const document = [...api.account().documents.values()].find((entry) => entry.canvas.title === 'Stress ' + count); assert.ok(document);
    const start = Date.now(); await select(documents, document.canvas.id); await browser.wait(`document.querySelectorAll('.react-flow__node').length===${count}`, 25_000);
    const last = (await currentScene(browser)).nodes.at(-1); await selectNode(last.id); await click(locate); await sleep(300);
    const measures = await browser.evaluate(`(()=>{const p=document.querySelector(${JSON.stringify(picker)});const r=p.getBoundingClientRect();const v=document.querySelector('[data-testid=canvas-viewport]').getBoundingClientRect();return {nodes:document.querySelectorAll('.react-flow__node').length,options:p.options.length,picker:{width:r.width,height:r.height},viewport:{width:v.width,height:v.height},documentWidth:document.documentElement.scrollWidth,innerWidth}})()`);
    assert.equal(measures.options, count + 1); assert.ok(measures.picker.height >= 43.5 && measures.documentWidth <= measures.innerWidth && measures.viewport.height > 0);
    assertCounts(stressCounts);
    stress.push({ count, edges: document.scene.edges.length, observedSelectAndLocateMs: Date.now() - start, measures });
    await browser.shot('phone-stress-' + count);
  }
  pass({ stress, measuredDevice: 'Desktop Chromium with 390 CSS px/touch emulation', noFPSOrLatencyGuarantee: true });

  setStage('Phone chat Chinese composition/Shift+Enter and explicit chat submission remain independent');
  await browser.byText(L.chat, L.mode); await browser.wait('Boolean(document.querySelector("textarea[placeholder]"))');
  const beforeChat = counts();
  await browser.replaceText('textarea[placeholder]', 'Phone chat ');
  const chatChinese = '\u624b\u673a\u5bf9\u8bdd\u4e2d\u6587\u6d4b\u8bd5';
  await browser.send('Input.imeSetComposition', { text: chatChinese, selectionStart: chatChinese.length, selectionEnd: chatChinese.length });
  await browser.key('Enter', 'Enter', 229); assertCounts(beforeChat);
  await browser.send('Input.insertText', { text: chatChinese });
  await browser.key('Enter', 'Enter', 13, 8); assertCounts(beforeChat);
  await browser.click('[aria-label="\u53d1\u9001"]'); await until(() => sends().length === beforeChat.runs + 1, 'Explicit phone chat send');
  assert.equal(sends().at(-1).body.canvasRun, undefined); assert.ok(sends().at(-1).body.conversationId);
  assert.equal(saves().length, beforeChat.saves);
  const chatMeasures = await browser.evaluate('({width:innerWidth,documentWidth:document.documentElement.scrollWidth,textareaWidth:document.querySelector("textarea[placeholder]").getBoundingClientRect().width})');
  assert.ok(chatMeasures.documentWidth <= chatMeasures.width && chatMeasures.textareaWidth > 100);
  pass({ explicitIndependentChatRequest: true, nativeCDPCompositionOnly: true, shiftEnterDoesNotSend: true, chatMeasures });

  setStage('Feature-off and owner changes retain real guards without implicit Run/Save or cross-owner display');
  const beforeGuard = counts();
  await browser.evaluate('window.__CANVAS_FIXTURE.setEnabled(false)'); await sleep(350);
  assert.equal(await browser.evaluate(`Boolean(document.querySelector(${JSON.stringify(L.mode)}))`), false);
  assertCounts(beforeGuard);
  await browser.evaluate('window.__CANVAS_FIXTURE.setEnabled(true)'); await sleep(450); await canvasMode(browser);
  assertCounts(beforeGuard);
  await browser.evaluate("window.__CANVAS_FIXTURE.switchOwner('fixture-owner-b')"); await sleep(450); await canvasMode(browser);
  assert.equal(await browser.evaluate('document.querySelectorAll(".react-flow__node").length'), 0);
  assert.equal(await browser.evaluate('document.body.textContent.includes("Phone C")'), false);
  assertCounts(beforeGuard);
  await browser.evaluate("window.__CANVAS_FIXTURE.switchOwner('fixture-owner-a')"); await sleep(450); await canvasMode(browser);
  await select(documents, phoneCanvasId); await browser.wait('document.querySelectorAll(".react-flow__node").length>0');
  assertCounts(beforeGuard);
  pass({ fixturePropNotProductionFlag: true, dummyOwnerIsolation: true, noRunOrSaveFromAvailabilityChanges: true });

  assert.equal(api.requests.some((request) => request.path.startsWith('/api/me/generations/') && request.method !== 'GET'), false);
  return { phoneCanvasId, phonePromptId, phoneGenerationId, sourceOnlyDeviceClaim: 'No physical phone, native OS keyboard/chooser/download or real-service authentication validation' };
}
