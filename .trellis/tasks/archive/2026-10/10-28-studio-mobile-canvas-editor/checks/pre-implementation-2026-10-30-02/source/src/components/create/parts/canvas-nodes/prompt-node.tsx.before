"use client";

import type { NodeProps } from "@xyflow/react";
import { TextCursorInput } from "lucide-react";
import { useState } from "react";

import { GENERATION_PROMPT_MAX_LENGTH } from "@/lib/generation/limits";
import { cn } from "@/lib/utils";

import { isCanvasSaveShortcut } from "../../canvas/renderer-adapter";
import { CANVAS_INPUT_CLASS, CANVAS_PORTS } from "../../canvas/renderer-constants";
import type { CanvasPromptFlowNode } from "../../canvas/renderer-types";
import styles from "../canvas-stage.module.css";
import { CanvasNodeShell, CanvasPort } from "./node-shell";

export function CanvasPromptNode({ data, selected }: NodeProps<CanvasPromptFlowNode>) {
  const { node, readOnly, actions } = data;
  // Flow forwards controller text through a passive store update. Keep the
  // native input synchronous so React cannot restore old text during IME input.
  const [input, setInput] = useState({ source: node.text, text: node.text });
  if (input.source !== node.text) setInput({ source: node.text, text: node.text });
  return (
    <CanvasNodeShell kind="prompt" selected={selected} readOnly={readOnly} onRemove={() => actions.removeNode(node.id)}>
      <div className={styles.nodeBody}>
        <p className={styles.nodeEyebrow}><TextCursorInput aria-hidden className="size-3.5" /> 描述你的画面</p>
        {readOnly ? (
          <p tabIndex={0} className={cn(CANVAS_INPUT_CLASS, styles.promptText)} onKeyDown={(event) => event.stopPropagation()}>{node.text || "尚未填写提示词"}</p>
        ) : (
          <textarea aria-label="节点提示词" value={input.text} maxLength={GENERATION_PROMPT_MAX_LENGTH} rows={5}
            className={cn(CANVAS_INPUT_CLASS, styles.promptInput)} placeholder="光线、构图、主体与风格……"
            onChange={(event) => {
              const text = event.target.value;
              // Keep accepted input synchronous, but never show rejected text as saved domain content.
              if (actions.updatePrompt(node.id, text)) setInput({ source: node.text, text });
            }}
            onKeyDown={(event) => { if (event.nativeEvent.isComposing || event.keyCode === 229 || !isCanvasSaveShortcut(event)) event.stopPropagation(); }} onWheel={(event) => event.stopPropagation()} />
        )}
        <div className={styles.nodeFootnote}><span>连接到生成节点</span><span>{node.text.length} / {GENERATION_PROMPT_MAX_LENGTH}</span></div>
      </div>
      <CanvasPort id={CANVAS_PORTS.promptOutput} type="source" label="提示词输出" variant="prompt" readOnly={readOnly} />
    </CanvasNodeShell>
  );
}
