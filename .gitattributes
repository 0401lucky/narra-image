# Trellis: append-only developer journals should merge cleanly across
# parallel sessions/worktrees — each session only appends a new block, so
# there is nothing to actually conflict on.
#
# Do NOT add a rule for workspace/*/index.md here — it is fully regenerated
# every session, so a real conflict there is expected and safe to resolve by
# picking either side (task state lives in task.json, not index.md). See
# .trellis/spec/cli/backend/directory-structure.md for details.
.trellis/workspace/*/journal-*.md merge=union

# Vite SSR must see an LF-terminated shebang in directly imported CLI modules.
scripts/verify-canvas-contracts-db.mjs text eol=lf
scripts/verify-e2e.mjs text eol=lf
scripts/fixtures/canvas-object-store.mjs text eol=lf

# Canvas and image migrations have shared, byte-bound checksum fixtures.
prisma/migrations/20261029090000_canvas_v1/migration.sql text eol=lf
prisma/migrations/20261112090000_image_storage/migration.sql text eol=lf
prisma/migrations/20261112100000_canvas_image_storage/migration.sql text eol=lf
prisma/migrations/20261115090000_image_retention/migration.sql text eol=lf
prisma/migrations/20261115180000_image_history/migration.sql text eol=lf

# Preserve original license and forensic before-image bytes, including whitespace.
# Application source, task helpers and authored documentation keep normal checks.
.trellis/tasks/**/checks/**/*.before -text whitespace=-blank-at-eol,-blank-at-eof
.trellis/tasks/**/checks/**/*.after -text
.trellis/tasks/**/research/asset-evidence/cormorant-garamond-OFL.txt -text whitespace=-blank-at-eol,-blank-at-eof
.trellis/tasks/**/research/asset-evidence/plus-jakarta-sans-OFL.txt -text whitespace=-blank-at-eol,-blank-at-eof
